# Machine-readable pins for the public-demo profile. Human-readable context,
# owners, and test status live in compatibility-matrix.md; keep both in sync.
# Registry images are pinned by tag AND digest (digests recorded from
# `docker pull` on 2026-09-25). Two images are local builds with no registry
# digest yet; compose.yaml labels them and the strict policy check rejects them.

NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:4714e0b1b2577eaa1a6131d07c958b67f0eb68e6d0521e90c6e5287db8cf0bc5
REDIS_IMAGE=redis:7.4.7-alpine@sha256:02f2cc4882f8bf87c79a220ac958f58c700bdec0dfb9b9ea61b62fb0e8f1bfcf
POSTGRES_IMAGE=postgres:16.15-alpine3.23@sha256:621a761097839bdb50207afd6b87a72f38e2d718dd46c3d744828d8917c4f1e0
METABASE_IMAGE=metabase/metabase:v0.58.34@sha256:abd7e4d9162e4dff67d5958d29e55b1e79de8029c51fddfdc12d9903ad126873
AIRFLOW_BASE_IMAGE=apache/airflow:3.3.2-python3.12@sha256:9df9c8be4096b9cc626bd7cb1f2b8c712eef66c59c615f8c7e6200871ca10bd1
SQUID_IMAGE=ubuntu/squid:6.6-24.04_beta@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029
CURL_IMAGE=curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
PYTHON_IMAGE=python:3.12.14-alpine3.24@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111

# Local build of this repository (test-chat frontend, gateway, worker).
# Replace with the GHCR release digest once a v* tag publishes one.
RUNTIME_IMAGE=distributed-agent-runtime-lab:0.1.0-public-demo-local
RUNTIME_IMAGE_SOURCE=local-build

# RAG gateway. LOCAL FIXTURE STAND-IN, not ai-platform-rag-observability.
# Swap to the pinned v0.2.0 digest and set RAG_IMAGE_SOURCE=registry when the
# real image is published; confirm RAG_PORT against its Dockerfile.
RAG_IMAGE=rag-gateway-fixture:0.2.0-fixture-local
RAG_IMAGE_SOURCE=local-build
RAG_PORT=8000

# Airflow: AIRFLOW_BASE_IMAGE plus owner-repository DAGs at pinned commits
# (deploy/public-demo/airflow/Dockerfile). Archive hashes are the SHA-256 of
# the GitHub codeload tarball for each commit, recorded on 2026-09-25.
AIRFLOW_IMAGE=airflow-public-demo:3.3.2-local
AIRFLOW_IMAGE_SOURCE=local-build
DATA_MAP_REPO=LucasRangelSSouza/brazil-public-data-map
DATA_MAP_COMMIT=2d8caa13d7e5a1237da6f57eda3cf92ab7882132
DATA_MAP_ARCHIVE_SHA256=2b95c8d04a906bd4e9784765e5aafecc248e870610a3e82ce9045904289b3019
MLOPS_REPO=LucasRangelSSouza/education-finance-mlops
MLOPS_COMMIT=f9954c47d50cf0bdd393759fa59b3f8daad7d881
MLOPS_ARCHIVE_SHA256=052be5c101862f8944d0e45e36f5bf6066b1ad3a4798c45a3b68161989d3c11b

# Analytics data. ANALYTICS_SOURCE=release loads the verified derivative that
# scripts/public_demo_load_release.py writes to analytics/release/;
# ANALYTICS_SOURCE=fixture loads the committed synthetic fixture instead.
ANALYTICS_SOURCE=release
EDUCATION_RELEASE_DATASET=lucasrangelss/brazil-education-data-lake
EDUCATION_RELEASE_VERSION=1
EDUCATION_RELEASE_MANIFEST_SHA256=44f259602a688432dddbae6b0306a6957514a634d57d94a0abd3cff30f4b3506
ANALYTICS_FIXTURE_VERSION=fixture-2026-09-25
DASHBOARD_SEED_VERSION=public-demo-dashboard-v1
